{% extends "base.html.j2" %}

{% block title %}{{ meta.curso }} em {{ nome_uf }} ({{ sigla }}) — Observatório Nacional da Educação Superior{% endblock %}
{% block meta_description %}{{ meta.curso }} em {{ nome_uf }}: {{ "{:,}".format(d.vagas_total).replace(',','.') }} vagas, {{ d.n_ies }} instituições, {{ d.municipios_oferta }} municípios com oferta presencial e {{ d.municipios_deserto }} desertos. Indicadores ICT, IAF e concentração (Censo INEP {{ meta.versao_censo }}).{% endblock %}

{% block breadcrumb %}
<span class="sep">›</span>
<a href="{{ depth }}curso/{{ meta.slug }}/index.html">{{ meta.curso }}</a>
<span class="sep">›</span>
<span class="active">{{ nome_uf }} ({{ sigla }})</span>
{% endblock %}

{% block content %}

<div class="linha linha-larga esp-b24">
  <h1 class="numero-destaque">{{ meta.curso }} em {{ nome_uf }}</h1>
  <span class="uf-tag uf-tag-grande">{{ sigla }}</span>
  <span class="nota-fonte">{{ d.regiao }} · capital {{ d.capital }}</span>
  <span class="cresce"></span>
  <button type="button" id="btn-json-uf"
          data-arquivo="{{ meta.slug }}_{{ sigla }}.json"
          class="btn outline btn-mini">↓ JSON</button>
</div>

{# Sem isto, a página de UF é um beco: dá para entrar e só voltar. #}
{% if ufs_curso|length > 1 %}
<nav class="uf-navegacao" aria-label="Outras unidades federativas com oferta de {{ meta.curso }}">
  <span class="uf-navegacao-rotulo">{{ meta.curso }} em:</span>
  {% for sig in ufs_curso %}
  {%- if sig == sigla %}
  <span class="uf-nav-item atual" aria-current="page">{{ sig }}</span>
  {%- else %}
  <a class="uf-nav-item" href="{{ sig }}.html" aria-label="{{ meta.curso }} em {{ sig }}">{{ sig }}</a>
  {%- endif %}
  {% endfor %}
</nav>
{% endif %}


{% if leituras %}
<section class="leituras" aria-labelledby="tit-leituras">
  <h2 class="section-title" id="tit-leituras">Leitura dos números</h2>
  <p class="leituras-aviso">
    Frases calculadas a partir dos dados desta página, por regra fixa. Descrevem
    variação, participação e posição — nunca causa. Cada número pode ser conferido
    nas tabelas abaixo.
  </p>
  <ul class="leituras-lista">
    {% for l in leituras %}
    <li class="leitura {{ l.tipo }}">{{ l.texto }}</li>
    {% endfor %}
  </ul>
</section>
{% endif %}

<h2 class="section-title">Indicadores principais</h2>
<div class="kpi-grid">

  {% macro kpi(valor, rotulo, fonte, classe='') %}
  <div class="kpi-card {{ classe }}{% if valor is none %} nodata{% endif %}">
    <div class="kpi-valor">{% if valor is not none %}{{ valor }}{% else %}<span class="sem-dado"><span aria-hidden="true">—</span><span class="sr-only">sem dados</span></span>{% endif %}</div>
    <div class="kpi-label">{{ rotulo }}</div>
    <div class="kpi-fonte">{{ fonte }}</div>
  </div>
  {% endmacro %}

  {{ kpi(fmt3(d.ICT), 'ICT ↓ (concentração)', 'Censo ' ~ meta.versao_censo,
        'bom' if d.ICT is not none and d.ICT < 0.5 else ('critico' if d.ICT is not none and d.ICT >= 0.75 else '')) }}
  {{ kpi(fmt3(d.E), 'Equidade ↑', 'Calculado') }}
  {{ kpi(fmt1(d.IAF), 'IAF ↑ (0–100)',
        ('ENADE ' ~ meta.ciclo_enade) if d.IAF is not none else 'sem ciclo ENADE',
        'bom' if d.IAF is not none and d.IAF >= 45 else ('critico' if d.IAF is not none and d.IAF < 30 else '')) }}
  {{ kpi(milhar(d.vagas_total), 'Vagas totais', 'presencial + EaD') }}
  {{ kpi(milhar(d.vagas_presencial), 'Vagas presenciais', (d.n_cursos_presencial|string) ~ ' cursos') }}
  {{ kpi(milhar(d.vagas_ead), 'Vagas EaD', 'sede da mantenedora') }}
  {{ kpi(d.n_ies, 'Instituições', 'Censo ' ~ meta.versao_censo) }}
  {{ kpi(d.municipios_oferta, 'Municípios c/ oferta', 'só presencial') }}
  {{ kpi(d.municipios_deserto, 'Desertos (de ' ~ d.municipios_total ~ ')', 'sem curso presencial', 'critico') }}
  {{ kpi(d.ead_polos_municipios, 'Municípios c/ polo EaD', 'alcance da EaD') }}
  {{ kpi(d.mun_ead_only, 'Municípios só EaD', 'sem curso presencial') }}
  {{ kpi(fmt1(d.vagas_por_100k), 'Vagas / 100 mil hab.', 'Censo + IBGE') }}

</div>

<h2 class="section-title">Qualidade avaliada</h2>
{% if d.ENADE is none %}
<p class="secao-intro">
  <strong>Sem dados de qualidade para {{ meta.curso }}.</strong>
  O ENADE é trienal e reveza as áreas de avaliação; o ciclo aplicável a este curso
  ainda não foi publicado pelo INEP. Nenhum conceito é estimado.
</p>
{% else %}
<div class="kpi-grid">
  {{ kpi(fmt2(d.ENADE), 'ENADE (contínuo)', 'INEP ' ~ meta.ciclo_enade) }}
  {{ kpi(fmt2(d.IDD), 'IDD (valor agregado)', 'INEP ' ~ meta.ciclo_enade) }}
  {{ kpi(fmt2(d.CPC_cont), 'CPC', 'INEP ' ~ meta.ciclo_enade) }}
  {{ kpi(fmt1(d.pct_doc_doutores), '% Doutores', 'INEP ' ~ meta.ciclo_enade) }}
  {{ kpi(fmt1(d.pct_doc_mestres), '% Mestres+', 'INEP ' ~ meta.ciclo_enade) }}
  {{ kpi(fmt1(d.pct_doc_regime), '% Regime int./parc.', 'INEP ' ~ meta.ciclo_enade) }}
  {{ kpi(fmt2(d.cpc_org_didatico), 'Org. didático-ped.', 'Questionário do Estudante') }}
  {{ kpi(fmt2(d.cpc_infraestrutura), 'Infraestrutura', 'Questionário do Estudante') }}
  {{ kpi(fmt2(d.cpc_oportunidade), 'Oport. de ampliação', 'Questionário do Estudante') }}
  {{ kpi(d.n_cursos_avaliados, 'Cursos avaliados', 'ciclo ' ~ meta.ciclo_enade) }}
</div>
{% endif %}

<h2 class="section-title">Acesso, perfil e concentração</h2>
<div class="kpi-grid">
  {{ kpi(fmt1(d.pct_ead), '% EaD na capacidade', 'Censo ' ~ meta.versao_censo) }}
  {{ kpi(fmt1(d.taxa_conclusao), 'Taxa de conclusão', 'concluintes / matrículas') }}
  {{ kpi(fmt1(d.pct_mulheres), '% Mulheres (ingressantes)', 'Censo ' ~ meta.versao_censo) }}
  {{ kpi(fmt1(d.pct_ppi), '% Pretos/pardos/indígenas', 'Censo ' ~ meta.versao_censo) }}
  {{ kpi(fmt1(d.pct_financiamento), '% FIES/PROUNI', 'Censo ' ~ meta.versao_censo) }}
  {{ kpi(fmt1(d.pct_noturno), '% Vagas noturnas', 'sobre presenciais') }}
  {{ kpi(fmt1(d.pct_rede_publica), '% Rede pública', 'Censo ' ~ meta.versao_censo) }}
  {{ kpi(fmt4(d.HHI), 'HHI ↓', 'concentração entre IES') }}
  {{ kpi(pct(d.CR2), 'CR2 (2 maiores)', 'Censo ' ~ meta.versao_censo) }}
  {{ kpi(pct(d.CR10), 'CR10 (10 maiores)', 'Censo ' ~ meta.versao_censo) }}
</div>

{% if mapa_uf %}
<h2 class="section-title">Onde há oferta</h2>
<p class="secao-intro">
  Aponte um município no mapa — ou percorra a tabela abaixo pelo teclado — para
  ver os números de {{ meta.curso }} naquele lugar.
</p>
<div class="figura mapa-com-painel">
  {{ mapa_uf }}
  <div class="mapa-painel" id="mapa-painel" role="status" aria-live="polite">
    <p class="mapa-painel-vazio">Nenhum município selecionado.</p>
    <div class="mapa-painel-dados" hidden>
      <p class="mapa-painel-nome" data-campo="nome"></p>
      <dl>
        <dt>População</dt><dd data-campo="populacao">—</dd>
        <dt>Matrículas</dt><dd data-campo="matriculas">—</dd>
        <dt>Instituições</dt><dd data-campo="n_ies">—</dd>
        <dt>Vagas</dt><dd data-campo="vagas">—</dd>
      </dl>
    </div>
  </div>
  <p class="figura-nota">
    Todos os municípios do estado aparecem — inclusive os que <strong>não</strong>
    têm {{ meta.curso }}, em cinza. A cor dos demais é a taxa de matrículas por
    100 mil habitantes, e não o total: num mapa de área, pintar valor absoluto
    premiaria o município grande com pouca oferta.
  </p>
  <p class="figura-nota">
    Polos EaD não aparecem — polo não é campus, e fundir os dois inflaria a
    leitura de cobertura territorial. <strong>Instituições</strong> conta as que
    ofertam este curso no município.
  </p>
</div>
{% endif %}

{% if municipios %}
<h2 class="section-title">Municípios com oferta presencial ({{ municipios|length }})</h2>
<div class="tabela-wrap" tabindex="0">
  <table>
    <caption class="sr-only">Municípios de {{ nome_uf }} com oferta presencial de {{ meta.curso }}, ordenados por número de vagas.</caption>
    <thead>
      <tr>
        <th scope="col">#</th><th scope="col">Município</th><th scope="col">Vagas</th>
        <th scope="col">Matrículas</th><th scope="col">Cursos</th><th scope="col">IES</th>
      </tr>
    </thead>
    <tbody>
      {% for m in municipios %}
      <tr{% if m.cod_ibge %} data-cod="{{ m.cod_ibge }}"{% endif %}>
        <td class="rank-pos">{{ loop.index }}</td>
        <th class="t-forte" scope="row">
          {% if m.slug %}<a href="{{ depth }}municipio/{{ sigla }}-{{ m.slug }}.html">{{ m.nome }}</a>
          {% else %}{{ m.nome }}{% endif %}
        </th>
        <td>{{ "{:,}".format(m.vagas_total).replace(',','.') }}</td>
        <td>{{ "{:,}".format(m.matriculas).replace(',','.') }}</td>
        <td>{{ m.n_cursos }}</td>
        <td>{{ m.n_ies }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

{% endblock %}

{% block dados %}
<script type="application/json" id="dados-uf">{{ dados_uf_json }}</script>
{% endblock %}

{% block scripts %}
<script src="../../../static/js/pagina-uf.js"></script>
<script src="../../../static/js/mapa-municipios.js"></script>
{% endblock %}
