{% extends "base.html.j2" %}

{% block title %}Municípios — Observatório Nacional da Educação Superior{% endblock %}
{% block meta_description %}Os {{ total }} municípios brasileiros com oferta presencial de ensino superior nos cursos acompanhados, com vagas, matrículas e número de cursos.{% endblock %}

{% block breadcrumb %}
<span class="sep">›</span>
<span class="active">Municípios</span>
{% endblock %}

{% block scripts %}
<script src="static/js/pagina-municipios.js"></script>
{% endblock %}

{% block content %}

<h1 class="section-title" style="margin-bottom:6px">Municípios com oferta presencial</h1>
<p style="font-size:0.9rem;color:var(--text-muted);max-width:75ch;margin-bottom:8px">
  <strong>{{ total }} dos 5.570 municípios brasileiros</strong> — {{ fmt1(100 * total / 5570) }}% —
  têm ao menos um curso presencial entre os acompanhados por este observatório.
  Nos outros {{ milhar(5570 - total) }}, quem quiser estas formações precisa sair da
  cidade ou estudar a distância.
</p>
<p style="font-size:0.9rem;color:var(--text-muted);max-width:75ch;margin-bottom:20px">
  Polos EaD não entram nesta contagem. No Censo, a vaga a distância pertence à sede
  da mantenedora, e um polo não equivale a um campus — fundir os dois inflaria a
  leitura de cobertura territorial.
</p>

<div class="catalogo-controles">
  <input type="search" id="filtro-municipio" placeholder="Buscar município…"
         aria-label="Buscar município" aria-describedby="contador-municipios">
  <select id="filtro-uf-mun" aria-label="Filtrar por unidade federativa">
    <option value="">Toda UF</option>
    {% for uf in ufs %}<option value="{{ uf }}">{{ uf }}</option>{% endfor %}
  </select>
  <span id="contador-municipios" class="filtro-contador" role="status" aria-live="polite"></span>
</div>

<div class="tabela-wrap">
  <table id="tabela-municipios">
    <caption class="sr-only">Municípios ordenados por vagas presenciais.</caption>
    <thead>
      <tr>
        <th scope="col">#</th><th scope="col">Município</th><th scope="col">UF</th>
        <th scope="col">Vagas</th><th scope="col">Matrículas</th>
        <th scope="col">Cursos distintos</th>
      </tr>
    </thead>
    <tbody>
      {% for m in municipios %}
      <tr data-nome="{{ m.nome|lower }}" data-uf="{{ m.uf }}">
        <td class="rank" style="color:var(--text-muted);width:52px">{{ loop.index }}</td>
        <th scope="row" style="font-weight:600">
          <a href="municipio/{{ m.uf }}-{{ m.slug }}.html">{{ m.nome }}</a>
        </th>
        <td>{{ m.uf }}</td>
        <td>{{ milhar(m.vagas_total) }}</td>
        <td>{{ milhar(m.matriculas) }}</td>
        <td>{{ m.cursos|length }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<p id="municipios-vazio" class="catalogo-vazio" hidden>Nenhum município corresponde ao filtro.</p>

{% endblock %}
