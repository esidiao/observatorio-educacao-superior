{% extends "base.html.j2" %}

{% block title %}Comparar cursos — Observatório Nacional da Educação Superior{% endblock %}
{% block meta_description %}Compare cursos de graduação lado a lado — vagas, participação da EaD, concentração territorial, qualidade avaliada e concentração institucional — no Brasil e por unidade federativa.{% endblock %}

{% block breadcrumb %}
<span class="sep">›</span>
<span class="active">Comparar cursos</span>
{% endblock %}

{% block content %}

<h1 class="section-title" style="margin-bottom:6px">Comparação entre cursos</h1>
<p style="font-size:0.9rem;color:var(--text-muted);margin-bottom:20px;max-width:75ch">
  A mesma régua aplicada a cursos diferentes. Escolha o recorte territorial — Brasil
  ou uma UF — e os indicadores que quer confrontar. Indicadores sem fonte para um
  curso aparecem como <span class="sem-dado">sem dados</span>, nunca como zero.
</p>

<div class="toolbar" style="gap:10px;margin-bottom:14px;align-items:center;flex-wrap:wrap">
  <label style="font-weight:600;color:var(--navy);font-size:0.875rem">Recorte:</label>
  <select id="sel-uf" onchange="renderTudo()" style="font-size:0.875rem"></select>
  <span style="flex:1"></span>
  <button class="btn outline" onclick="exportarCSV(linhasCSV(), 'comparacao_cursos.csv')" style="font-size:0.78rem;padding:5px 10px">↓ CSV</button>
</div>

<div class="toolbar" style="flex-direction:column;align-items:stretch;gap:10px;margin-bottom:20px">
  <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
    <label style="font-weight:600;color:var(--navy);font-size:0.875rem">Cursos:</label>
    <div id="curso-chips" style="display:flex;flex-wrap:wrap;gap:6px"></div>
  </div>
  <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
    <label style="font-weight:600;color:var(--navy);font-size:0.875rem">Indicadores:</label>
    <span id="kpi-contador" style="font-size:0.78rem;color:var(--text-muted)"></span>
    <span style="flex:1"></span>
    <button class="btn outline" style="font-size:0.76rem;padding:4px 10px" onclick="preset('Território')">Território</button>
    <button class="btn outline" style="font-size:0.76rem;padding:4px 10px" onclick="preset('Qualidade')">Qualidade</button>
    <button class="btn outline" style="font-size:0.76rem;padding:4px 10px" onclick="preset('Capacidade')">Capacidade</button>
    <button class="btn outline" style="font-size:0.76rem;padding:4px 10px" onclick="preset('Mercado')">Mercado</button>
  </div>
  <div id="kpi-chips"></div>
</div>

<h2 class="section-title">Tabela comparativa</h2>
<div class="tabela-wrap">
  <table id="tabela-comp">
    <thead><tr id="comp-thead"></tr></thead>
    <tbody id="comp-tbody"></tbody>
  </table>
</div>

<div id="msg-vazio" style="text-align:center;padding:32px;color:var(--text-muted);display:none">
  Selecione ao menos um curso e um indicador.
</div>

<h2 class="section-title" style="margin-top:28px">Perfil relativo (normalizado)</h2>
<p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:12px;max-width:75ch">
  Cada barra vai de 0 a 1, onde <strong>1 = melhor entre os cursos comparados</strong>
  neste recorte. Indicadores "menor é melhor" são invertidos; os contextuais seguem a
  própria escala. Serve para ver formato, não para ranquear cursos entre si —
  áreas diferentes têm realidades diferentes.
</p>
<div id="barras-norm"></div>

{% endblock %}

{% block scripts %}
<script>
const CURSOS = {{ cursos_json }};
const DADOS = {{ comparacao_json }};   // {slug: {BR: {...}, UF: {...}}}
const UFS = {{ ufs_json }};

let selCursos = new Set(CURSOS.map(c => c.slug));
let selKPIs = new Set(['vagas_total', 'pct_ead', 'ICT', 'IAF', 'n_ies', 'HHI']);
let recorte = 'BR';

const CATALOGO = (typeof GLOSSARIO !== 'undefined' ? GLOSSARIO : [])
  .filter(g => CURSOS.some(c => {
    const d = (DADOS[c.slug] || {})['BR'];
    return d && d[g.key] !== null && d[g.key] !== undefined;
  }));

function valor(slug, key) {
  const d = (DADOS[slug] || {})[recorte];
  return d ? d[key] : null;
}

function renderSeletorUF() {
  const sel = document.getElementById('sel-uf');
  sel.innerHTML = '<option value="BR">Brasil (todas as UFs)</option>'
    + UFS.map(uf => `<option value="${uf}">${uf}</option>`).join('');
  sel.value = recorte;
}

function renderCursoChips() {
  document.getElementById('curso-chips').innerHTML = CURSOS.map(c => {
    const on = selCursos.has(c.slug);
    return `<button class="btn outline" onclick="toggleCurso('${c.slug}')"
      style="padding:4px 12px;font-size:0.8rem;${on ? 'background:var(--blue);color:#fff' : ''}">${c.nome}</button>`;
  }).join('');
}

function renderKpiChips() {
  const ordem = ['Território', 'Qualidade', 'Capacidade', 'Acesso & equidade', 'Mercado'];
  let html = '';
  ordem.forEach(cat => {
    const itens = CATALOGO.filter(g => g.cat === cat);
    if (!itens.length) return;
    html += `<div style="margin-bottom:8px"><div style="font-size:0.68rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--gold);font-weight:700;margin-bottom:5px">${cat}</div><div style="display:flex;flex-wrap:wrap;gap:6px">`;
    itens.forEach(g => {
      const on = selKPIs.has(g.key);
      html += `<button class="btn outline" onclick="toggleKPI('${g.key}')" title="${g.nome}"
        style="padding:3px 9px;font-size:0.76rem;${on ? 'background:var(--blue);color:#fff' : ''}">${g.sigla}</button>`;
    });
    html += '</div></div>';
  });
  document.getElementById('kpi-chips').innerHTML = html;
  document.getElementById('kpi-contador').textContent = `(${selKPIs.size} selecionados)`;
}

function toggleCurso(slug) {
  selCursos.has(slug) ? selCursos.delete(slug) : selCursos.add(slug);
  renderCursoChips(); renderTudo();
}
function toggleKPI(key) {
  selKPIs.has(key) ? selKPIs.delete(key) : selKPIs.add(key);
  renderKpiChips(); renderTudo();
}
function preset(cat) {
  selKPIs = new Set(CATALOGO.filter(g => g.cat === cat).map(g => g.key));
  renderKpiChips(); renderTudo();
}

function linhasCSV() {
  const keys = [...selKPIs];
  return CURSOS.filter(c => selCursos.has(c.slug)).map(c => {
    const linha = { curso: c.nome, recorte };
    keys.forEach(k => { linha[k] = valor(c.slug, k); });
    return linha;
  });
}

function renderTabela() {
  const cursos = CURSOS.filter(c => selCursos.has(c.slug));
  const keys = [...selKPIs];
  const vazio = !cursos.length || !keys.length;
  document.getElementById('msg-vazio').style.display = vazio ? 'block' : 'none';
  document.getElementById('tabela-comp').style.display = vazio ? 'none' : '';
  if (vazio) return;

  document.getElementById('comp-thead').innerHTML =
    '<th>Curso</th>' + keys.map(k => `<th title="${rotuloIndicador(k)}">${rotuloIndicador(k)}</th>`).join('');

  document.getElementById('comp-tbody').innerHTML = cursos.map(c => {
    const celulas = keys.map(k => {
      const v = valor(c.slug, k);
      if (v === null || v === undefined) return '<td class="sem-dado">sem dados</td>';
      return `<td>${fmtIndicador(k, v)}</td>`;
    }).join('');
    return `<tr><td><a href="curso/${c.slug}/index.html"><strong>${c.nome}</strong></a></td>${celulas}</tr>`;
  }).join('');
}

function renderBarras() {
  const cursos = CURSOS.filter(c => selCursos.has(c.slug));
  const keys = [...selKPIs];
  const raiz = document.getElementById('barras-norm');
  if (!cursos.length || !keys.length) { raiz.innerHTML = ''; return; }

  const PALETA = ['#2E5496', '#B07D22', '#3F6B2E', '#B23A2E', '#8B5CF6', '#06B6D4'];
  raiz.innerHTML = keys.map(k => {
    const valores = cursos.map(c => valor(c.slug, k));
    const barras = cursos.map((c, i) => {
      const v = valores[i];
      const n = normalizar(k, v, valores);
      if (n === null) {
        return `<div style="display:flex;align-items:center;gap:10px;margin-bottom:5px">
          <span style="width:150px;font-size:0.8rem;flex-shrink:0">${c.nome}</span>
          <span class="sem-dado" style="font-size:0.78rem">sem dados</span></div>`;
      }
      return `<div style="display:flex;align-items:center;gap:10px;margin-bottom:5px">
        <span style="width:150px;font-size:0.8rem;flex-shrink:0">${c.nome}</span>
        <span style="flex:1;background:var(--border);border-radius:4px;height:16px;position:relative;max-width:420px">
          <span style="position:absolute;inset:0 auto 0 0;width:${(n * 100).toFixed(1)}%;background:${PALETA[i % PALETA.length]};border-radius:4px"></span>
        </span>
        <span style="font-size:0.8rem;font-weight:600;width:90px;text-align:right">${fmtIndicador(k, v)}</span>
      </div>`;
    }).join('');
    return `<div style="margin-bottom:20px">
      <div style="font-size:0.85rem;font-weight:700;color:var(--navy);margin-bottom:8px">${rotuloIndicador(k)}</div>
      ${barras}</div>`;
  }).join('');
}

function renderTudo() {
  const sel = document.getElementById('sel-uf');
  if (sel && sel.value) recorte = sel.value;
  renderTabela();
  renderBarras();
}

document.addEventListener('DOMContentLoaded', () => {
  renderSeletorUF();
  renderCursoChips();
  renderKpiChips();
  renderTudo();
});
</script>
{% endblock %}
