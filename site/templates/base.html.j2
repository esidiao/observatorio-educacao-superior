<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}Observatório Nacional da Educação Superior{% endblock %}</title>
  <meta name="description" content="{% block meta_description %}Indicadores de acesso territorial, qualidade, capacidade e concentração da educação superior brasileira, por curso e por unidade federativa, a partir de dados oficiais do INEP e do IBGE.{% endblock %}">

  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'none'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'none'; media-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#15314F">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Observatório Nacional da Educação Superior">
  <meta property="og:title" content="{% block og_title %}Observatório Nacional da Educação Superior{% endblock %}">
  <meta property="og:locale" content="pt_BR">

  <link rel="stylesheet" href="{{ depth }}static/css/style.css">
  {% block head_extra %}{% endblock %}
</head>
<body data-depth="{{ depth }}" data-curso-atual="{{ curso_atual or '' }}">

<a class="pular-para-conteudo" href="#conteudo">Pular para o conteúdo</a>

<svg class="pos-abs" width="0" height="0" aria-hidden="true">
  <defs>
    <symbol id="i-home" viewBox="0 0 24 24"><path d="M3 11l9-8 9 8M5 10v10h5v-6h4v6h5V10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="i-book" viewBox="0 0 24 24"><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2zM19 3v18M8 7h7M8 11h7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="i-swap" viewBox="0 0 24 24"><path d="M7 7h13M7 7l3-3M7 7l3 3M17 17H4M17 17l-3-3M17 17l-3 3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="i-phone" viewBox="0 0 24 24"><path d="M5 4h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="i-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="i-cap" viewBox="0 0 24 24"><path d="M2 8l10-4 10 4-10 4zM6 11v5c0 1 3 2 6 2s6-1 6-2v-5M22 8v6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  </defs>
</svg>

<header class="site-header" role="banner">
  <a href="{{ depth }}index.html" class="brand" aria-label="Página inicial">
    <span class="brand-text">
      <span class="brand-name">Observatório Nacional</span>
      <span class="brand-sub">da Educação Superior</span>
    </span>
  </a>
  <p class="header-tag">Acesso territorial, qualidade, capacidade e concentração · Censo INEP {{ versao_censo }}</p>
</header>

<nav class="navbar" aria-label="Navegação">
  <a href="{{ depth }}index.html" class="nav-home" title="Página inicial" aria-label="Início"><svg class="ic" aria-hidden="true"><use href="#i-home"/></svg></a>
  <span class="breadcrumb-trail">
    {% block breadcrumb %}{% endblock %}
  </span>
  <span class="nav-menu">
    <a class="nota-fonte" href="{{ depth }}comparar-cursos.html">Comparar</a>
    <span class="sep">·</span>
    <a class="nota-fonte" href="{{ depth }}regioes.html">Regiões</a>
    <span class="sep">·</span>
    <a class="nota-fonte" href="{{ depth }}redes.html">Redes</a>
    <span class="sep">·</span>
    <a class="nota-fonte" href="{{ depth }}acesso.html">Acesso</a>
    <span class="sep">·</span>
    <a class="nota-fonte" href="{{ depth }}estados.html">Estados</a>
    <span class="sep">·</span>
    <a class="nota-fonte" href="{{ depth }}municipios.html">Municípios</a>
    <span class="sep">·</span>
    <a class="nota-fonte" href="{{ depth }}instituicoes.html">Instituições</a>
    <span class="sep">·</span>
    <a class="nota-fonte" href="{{ depth }}rankings.html">Rankings</a>
    <span class="sep">·</span>
    <a class="nota-fonte" href="{{ depth }}metodologia.html">Metodologia</a>
    <span class="sep">·</span>
    <a class="nota-fonte" href="{{ depth }}autor.html">Sobre o Autor</a>
    <span class="sep">·</span>
    <a href="#glossario" class="nav-glossario texto-menor"><svg class="ic" aria-hidden="true"><use href="#i-book"/></svg> Entenda os indicadores</a>
  </span>
  <div class="cresce"></div>
  <span class="navbar-carimbo">Dados: {{ data_extracao }}</span>
</nav>

{# O seletor é montado por JS a partir de window.CURSOS (static/js/cursos.js).
   Listar centenas de cursos no HTML de cada página pesaria mais que o site inteiro. #}
<div class="seletor-curso" aria-label="Selecionar curso">
  <span class="seletor-curso-rotulo">Curso:</span>
  <div class="curso-busca">
    <input type="search" id="curso-busca" autocomplete="off" role="combobox"
           aria-expanded="false" aria-controls="curso-sugestoes"
           placeholder="Buscar entre os cursos do Censo…" aria-label="Buscar curso">
    <ul id="curso-sugestoes" class="curso-sugestoes" role="listbox" hidden></ul>
  </div>
  <span id="curso-atual-chip" class="curso-chip ativo" hidden></span>
  <p id="curso-busca-resultado" class="sr-only" role="status" aria-live="polite"></p>
  <span class="cresce"></span>
  <a href="{{ depth }}index.html#catalogo" class="curso-chip">Todos os cursos</a>
  <a href="{{ depth }}comparar-cursos.html" class="curso-chip comparar"><svg class="ic" aria-hidden="true"><use href="#i-swap"/></svg> Comparar</a>
</div>

<main id="conteudo" tabindex="-1">
  {% block content %}{% endblock %}

  <section id="glossario" class="glossario" aria-label="Glossário de indicadores">
    <h2 class="section-title"><svg class="ic t-acento" aria-hidden="true"><use href="#i-book"/></svg> Entenda os indicadores</h2>
    <p class="glossario-intro">
      Cada indicador explica <strong>o que mede</strong>, sua <strong>escala</strong>,
      se <strong>maior ou menor é melhor</strong> e a <strong>fonte oficial</strong>.
    </p>
    <div class="glossario-busca">
      <input type="search" id="glossario-filtro" placeholder="Buscar indicador (ex.: ICT, EaD, desertos, qualidade…)"
             aria-label="Buscar indicador" aria-describedby="glossario-resultado">
    </div>
    <p id="glossario-resultado" class="sr-only" role="status" aria-live="polite"></p>
    <div id="glossario-lista" class="glossario-lista"></div>
  </section>
</main>

<footer class="site-footer">
  <p>Observatório Nacional da Educação Superior · Fontes: INEP (Censo da Educação Superior {{ versao_censo }} e ENADE/CPC), IBGE</p>
  <p class="esp-t6">
    © {{ ano_corrente }} <strong>Edson Sidião de Souza Júnior</strong> · Todos os direitos reservados ·
    Obra protegida pelas Leis nº 9.610/1998 e nº 9.609/1998 ·
    <a href="{{ depth }}aviso-legal.html">Direitos Autorais e Condições de Uso</a>
  </p>
  <p class="esp-t6">
    <a href="{{ depth }}autor.html">Sobre o Autor</a> ·
    <a href="{{ depth }}privacidade.html">Privacidade e dados pessoais</a> ·
    <a href="{{ depth }}api.html">Dados abertos</a> ·
    <a href="{{ depth }}metodologia.html">Metodologia</a>
  </p>
  <p class="esp-t6 atenuado">
    Dados primários de fontes oficiais públicas; o tratamento, os indicadores e a
    análise são obra autoral original.
  </p>
  <p class="esp-t6 atenuado">
    Nenhum indicador é estimado. Sem fonte para um recorte, o valor aparece como
    <strong>sem dados</strong> — nunca como um número inventado.
  </p>
</footer>

<script src="{{ depth }}static/js/cursos.js"></script>
<script src="{{ depth }}static/js/app.js"></script>
<script src="{{ depth }}static/js/glossario.js"></script>
<script src="{{ depth }}static/js/seletor-curso.js"></script>
<script src="{{ depth }}static/js/exportar-figura.js"></script>
{% block dados %}{% endblock %}
{% block scripts %}{% endblock %}
</body>
</html>
