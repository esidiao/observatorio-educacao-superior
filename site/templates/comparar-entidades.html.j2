{% extends "base.html.j2" %}

{% block title %}{{ titulo }} — Observatório Nacional da Educação Superior{% endblock %}
{% block meta_description %}{{ descricao }}{% endblock %}

{% block breadcrumb %}
<span class="sep">›</span>
<span class="active">{{ titulo }}</span>
{% endblock %}

{% block scripts %}
<script src="static/js/{{ arquivo_dados }}"></script>
<script src="static/js/pagina-comparar-entidades.js"></script>
{% endblock %}

{% block content %}

<nav class="rank-indice" aria-label="Outras comparações">
  <a href="{{ depth }}comparar-cursos.html">Comparar cursos</a>
  <a href="{{ depth }}comparar-estados.html">Comparar estados</a>
  <a href="{{ depth }}comparar-instituicoes.html">Comparar instituições</a>
</nav>

<h1 class="section-title" style="margin-bottom:6px">{{ titulo }}</h1>
<p style="font-size:0.9rem;color:var(--text-muted);max-width:75ch;margin-bottom:8px">
  {{ descricao }}
</p>
<p style="font-size:0.9rem;color:var(--text-muted);max-width:75ch;margin-bottom:22px">
  {{ ressalva }}
</p>

<div class="toolbar" style="flex-direction:column;align-items:stretch;gap:10px;margin-bottom:20px">
  <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
    <label style="font-weight:600;color:var(--navy);font-size:0.875rem" for="busca-entidade">{{ rotulo_entidade }}:</label>
    <input type="search" id="busca-entidade" autocomplete="off"
           placeholder="Adicionar à comparação…" aria-label="Buscar para comparar"
           style="flex:1 1 240px;max-width:360px">
    <button type="button" class="btn outline btn-mini" id="btn-limpar">Limpar</button>
    <button type="button" class="btn outline btn-mini" id="btn-padrao">Restaurar padrão</button>
    <span style="flex:1"></span>
    <button type="button" class="btn outline btn-mini" id="btn-csv">↓ CSV</button>
  </div>
  <p id="comp-aviso" class="sr-only" role="status" aria-live="polite"></p>
  <div id="sugestoes" class="comp-sugestoes" hidden></div>
  <div id="chips" style="display:flex;flex-wrap:wrap;gap:6px"></div>
  <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
    <label style="font-weight:600;color:var(--navy);font-size:0.875rem">Indicadores:</label>
  </div>
  <div id="campos" style="display:flex;flex-wrap:wrap;gap:6px"></div>
</div>

<h2 class="section-title">Tabela comparativa</h2>
<div class="tabela-wrap">
  <table id="tabela">
    <caption class="sr-only">{{ titulo }} — indicadores selecionados.</caption>
    <thead><tr id="thead"></tr></thead>
    <tbody id="tbody"></tbody>
  </table>
</div>
<div id="msg-vazio" style="text-align:center;padding:32px;color:var(--text-muted)" hidden>
  Selecione ao menos um item e um indicador.
</div>

<h2 class="section-title" style="margin-top:28px">Comparação visual</h2>
<p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:12px;max-width:75ch">
  Cada barra é proporcional ao maior valor entre os selecionados, indicador por
  indicador. Serve para ver ordem de grandeza; o número exato está na tabela acima.
</p>
<div id="barras"></div>

{% endblock %}
