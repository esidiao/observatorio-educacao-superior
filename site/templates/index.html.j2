{% extends "base.html.j2" %}

{% block title %}Observatório Nacional da Educação Superior{% endblock %}

{% block scripts %}
<script src="static/js/pagina-index.js"></script>
{% endblock %}

{% block content %}

<section class="hero">
  <p class="hero-eyebrow">{{ resumo_cursos|length }} cursos · 27 estados · Censo INEP {{ versao_censo }}</p>
  <h1 class="hero-title">Quem o Brasil forma, onde e com que qualidade?</h1>
  <p class="hero-lead">
    Um retrato da educação superior brasileira a partir de dados oficiais: onde cada
    curso é ofertado, quanto da capacidade migrou para a modalidade a distância,
    quão concentrada é a oferta e o que a avaliação do INEP mostra sobre a qualidade.
    A mesma régua aplicada a cursos diferentes.
  </p>
  <div class="hero-stats">
    <div class="lede"><span class="lede-num">{{ "{:,}".format(agregado.vagas_total).replace(',','.') }}</span><span class="lede-lab">vagas nos cursos analisados</span></div>
    <div class="lede"><span class="lede-num">{{ agregado.n_cursos }}</span><span class="lede-lab">cursos no observatório</span></div>
    <div class="lede"><span class="lede-num">{{ "{:,}".format(agregado.matriculas).replace(',','.') }}</span><span class="lede-lab">matrículas presenciais</span></div>
  </div>
  <div class="hero-cta">
    <a class="btn" href="comparar-cursos.html">Comparar cursos</a>
    <a class="btn outline" href="metodologia.html">Como os dados são construídos</a>
  </div>
</section>

<h2 class="section-title">Painel executivo</h2>
<p class="secao-intro">
  O sistema de educação superior brasileiro em números, nos recortes que este
  observatório consegue sustentar com fonte oficial.
</p>

<div class="kpi-grid">
  {% macro kpi_br(valor, rotulo, fonte, classe='') %}
  <div class="kpi-card {{ classe }}{% if valor is none %} nodata{% endif %}">
    <div class="kpi-valor">{% if valor is not none %}{{ valor }}{% else %}<span class="sem-dado"><span aria-hidden="true">—</span><span class="sr-only">sem dados</span></span>{% endif %}</div>
    <div class="kpi-label">{{ rotulo }}</div>
    <div class="kpi-fonte">{{ fonte }}</div>
  </div>
  {% endmacro %}
  {{ kpi_br(milhar(painel.vagas), 'Vagas', 'Censo ' ~ versao_censo) }}
  {{ kpi_br(milhar(painel.matriculas), 'Matrículas presenciais', 'Censo ' ~ versao_censo) }}
  {{ kpi_br(milhar(painel.cursos), 'Cursos (rótulos CINE)', 'Censo ' ~ versao_censo) }}
  {{ kpi_br(milhar(painel.ies), 'Instituições', 'Censo ' ~ versao_censo) }}
  {{ kpi_br(milhar(painel.municipios), 'Municípios com oferta presencial', 'de 5.570') }}
  {{ kpi_br((fmt1(painel.pct_ead) ~ '%') if painel.pct_ead is not none else none, 'Da capacidade é EaD', 'Censo ' ~ versao_censo) }}
  {{ kpi_br((fmt1(painel.evasao) ~ '%') if painel.evasao is not none else none, 'Evasão', 'coorte ' ~ (painel.coorte or ''), 'critico') }}
  {{ kpi_br((fmt1(painel.conclusao) ~ '%') if painel.conclusao is not none else none, 'Conclusão', 'coorte acompanhada') }}
</div>

{% if leituras %}
<section class="leituras" aria-labelledby="tit-leituras">
  <h2 class="section-title" id="tit-leituras">Leitura dos números</h2>
  <p class="leituras-aviso">
    Frases calculadas por regra a partir dos dados desta página. Descrevem variação,
    participação e posição — nunca causa, e nunca por modelo de linguagem.
  </p>
  <ul class="leituras-lista">
    {% for l in leituras %}<li class="leitura {{ l.tipo }}">{{ l.texto }}</li>{% endfor %}
  </ul>
</section>
{% endif %}

{% if grafico_modalidade %}
<div class="figura">
  {{ grafico_modalidade }}
  <p class="figura-nota">
    Vagas somadas de todos os cursos do catálogo, por edição do Censo
    ({{ anos_br|first }}–{{ anos_br|last }}). As vagas EaD são registradas na sede da
    mantenedora, não no polo — ver a metodologia.
  </p>
</div>
{% endif %}

{% if grafico_evasao %}
<div class="figura">
  {{ grafico_evasao }}
  <p class="figura-nota">
    Estes são os <strong>únicos indicadores do site que acompanham as mesmas
    pessoas</strong>: o INEP segue coortes de ingressantes até o desfecho. Todo o
    resto vem do Censo, que é retrato anual de estoque. As séries têm comprimentos
    diferentes porque a evasão é publicada desde 2010 e a conclusão desde 2016.
  </p>
</div>
{% endif %}

<h2 class="section-title" id="catalogo">Cursos no observatório</h2>
<p class="secao-intro">
  Todos os {{ resumo_cursos|length }} rótulos CINE do Censo, agrupados pela área geral
  da classificação. A lista é o que o Censo declara — inclusive cursos minúsculos, que
  aparecem com os números que têm.
</p>

<div class="catalogo-controles">
  <input type="search" id="filtro-curso" placeholder="Filtrar por nome do curso…"
         aria-label="Filtrar cursos por nome" aria-describedby="filtro-contador">
  <select id="filtro-area" aria-label="Filtrar por área CINE">
    <option value="">Todas as áreas</option>
    {% for area, itens in areas %}
    <option value="{{ area }}">{{ area }} ({{ itens|length }})</option>
    {% endfor %}
  </select>
  <span id="filtro-contador" class="filtro-contador" role="status" aria-live="polite"></span>
</div>

{% for area, itens in areas %}
<section class="area-bloco" data-area="{{ area }}">
  <h3 class="area-titulo">
    {{ area }}
    <span class="area-meta">{{ itens|length }} cursos · {{ "{:,}".format(itens|sum(attribute='vagas_total')).replace(',','.') }} vagas</span>
  </h3>
  <div class="areas-grid">
    {% for c in itens %}
    <a class="curso-card" href="curso/{{ c.slug }}/index.html" data-nome="{{ c.nome|lower }}">
      <h4>{{ c.nome }}</h4>
      <p class="curso-area">{{ c.area_especifica or c.area_cine }}{% if c.graus %} · {{ c.graus|join(', ') }}{% endif %}</p>
      <div class="curso-nums">
        <span><strong>{{ "{:,}".format(c.vagas_total).replace(',','.') }}</strong> vagas</span>
        {% if c.pct_ead is not none %}<span><strong>{{ c.pct_ead }}%</strong> EaD</span>{% endif %}
        <span><strong>{{ c.municipios_oferta }}</strong> municípios</span>
        <span><strong>{{ c.n_ufs }}</strong> UFs</span>
      </div>
      {% if not c.tem_qualidade %}
      <p class="curso-aviso">Sem ciclo ENADE publicado — qualidade sem dados</p>
      {% endif %}
    </a>
    {% endfor %}
  </div>
</section>
{% endfor %}

<p id="catalogo-vazio" class="catalogo-vazio" hidden>Nenhum curso corresponde ao filtro.</p>

<h2 class="section-title">O que este observatório não faz</h2>
<p class="texto-explicativo">
  Não estima. Quando não existe fonte oficial para um recorte, o indicador aparece
  como <span class="sem-dado">sem dados</span> — nunca como zero nem como uma média
  plausível. O ENADE é trienal e reveza as áreas avaliadas, então cursos fora do
  ciclo vigente simplesmente não têm indicadores de qualidade aqui.
</p>
<p class="texto-explicativo texto-explicativo-folgado">
  Também não trata áreas diferentes como se fossem comparáveis em tudo. A comparação
  entre cursos serve para revelar padrões estruturais — concentração, migração para
  EaD, cobertura territorial —, não para ordenar carreiras por mérito.
</p>


{% endblock %}
